                        <i class="fa-solid fa-bus-simple text-blue-400"></i> Datos del Recorrido
                    </h3>

                    <form id="route-schedule-form" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-200 mb-1">Chofer / Tag de Discord</label>
                            <input type="text" id="sch-driver" placeholder="Ej: @Chofer_Paredes" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-chile-blue">
                        </div>

