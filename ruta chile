            <button onclick="switchTab('agenda'); toggleMobileMenu();" class="w-full text-left px-4 py-3 rounded-xl text-sm font-bold text-slate-200 hover:bg-slate-800 flex items-center gap-3">
                <i class="fa-solid fa-calendar-days w-5 text-blue-400"></i> Programar Salida
            </button>
            <button onclick="switchTab('rutas'); toggleMobileMenu();" class="w-full text-left px-4 py-3 rounded-xl text-sm font-bold text-slate-200 hover:bg-slate-800 flex items-center gap-3">
                <i class="fa-solid fa-route w-5 text-chile-red"></i> Rutas & Mapa
            </button>
            <button onclick="switchTab('pasajes'); toggleMobileMenu();" class="w-full text-left px-4 py-3 rounded-xl text-sm font-bold text-slate-200 hover:bg-slate-800 flex items-center gap-3">
                <i class="fa-solid fa-ticket w-5 text-emerald-400"></i> Generar Pasaje
            </button>
            <button onclick="switchTab('peajes'); toggleMobileMenu();" class="w-full text-left px-4 py-3 rounded-xl text-sm font-bold text-slate-200 hover:bg-slate-800 flex items-center gap-3">
                <i class="fa-solid fa-calculator w-5 text-amber-400"></i> Peajes & Bencina
            </button>
            <button onclick="switchTab('flota'); toggleMobileMenu();" class="w-full text-left px-4 py-3 rounded-xl text-sm font-bold text-slate-200 hover:bg-slate-800 flex items-center gap-3">
