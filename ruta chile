                                <i class="fa-solid fa-plus-circle text-amber-400"></i> Agendar Salida
                            </button>
                            <button onclick="switchTab('pasajes')" class="px-5 py-3 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-emerald-600 text-white font-extrabold text-xs sm:text-sm transition-all shadow-xl shadow-emerald-900/40 hover:scale-105 active:scale-95 flex items-center gap-2">
