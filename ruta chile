        function downloadTicketCard() {
            const code = `PASAJE-RP-${Date.now().toString().slice(-6)}`;
            copyToClipboard(`🎫 [BOLETO BUS CHILE RP]\nPasajero: ${document.getElementById('tkt-name').value}\nEmpresa: ${document.getElementById('tkt-company').value}\nTramo: ${document.getElementById('tkt-route').value}\nAsiento: N° ${document.getElementById('tkt-seat').value}\nCódigo: ${code}`);
            showToast('¡Datos del pasaje copiados para el chat de Discord!');
        }

        function calculateTolls() {
            const route = document.getElementById('toll-route-select').value;
            const category = document.getElementById('toll-category').value;
            const fuelPrice = parseFloat(document.getElementById('fuel-price').value) || 1050;

            let numTolls = 4;
            let distanceKm = 400;

            if (route === 'stgo-talca') { numTolls = 3; distanceKm = 255; }
            if (route === 'stgo-pichilemu') { numTolls = 2; distanceKm = 210; }
            if (route === 'stgo-curico') { numTolls = 2; distanceKm = 190; }

            const tollPrice = (category === 'bus3') ? 3500 : 3200;
            const totalTolls = numTolls * tollPrice;

            const litersNeeded = (distanceKm / 3.5);
            const totalFuel = litersNeeded * fuelPrice;

            document.getElementById('res-tolls').innerText = `$${totalTolls.toLocaleString('es-CL')} CLP`;
            document.getElementById('res-fuel').innerText = `$${Math.round(totalFuel).toLocaleString('es-CL')} CLP`;
            document.getElementById('res-total').innerText = `$${Math.round(totalTolls + totalFuel).toLocaleString('es-CL')} CLP`;

            const tollsListBox = document.getElementById('tolls-list-box');
            if (tollsListBox) {
                tollsListBox.innerHTML = `
                    <div class="flex justify-between bg-slate-900 p-2 rounded"><span>Peaje Angostura (KM 57)</span> <span>$${tollPrice} CLP</span></div>
                    ${numTolls >= 2 ? `<div class="flex justify-between bg-slate-900 p-2 rounded"><span>Peaje Quinta (KM 162)</span> <span>$${tollPrice} CLP</span></div>` : ''}
                    ${numTolls >= 3 ? `<div class="flex justify-between bg-slate-900 p-2 rounded"><span>Peaje Maquehua (KM 238)</span> <span>$${tollPrice} CLP</span></div>` : ''}
                    ${numTolls >= 4 ? `<div class="flex justify-between bg-slate-900 p-2 rounded"><span>Peaje Retiro (KM 320)</span> <span>$${tollPrice} CLP</span></div>` : ''}
                `;
            }
        }

        function copyToClipboard(text) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showToast('Copiado al portapapeles');
        }

        function updateClock() {
            const now = new Date();
            const el = document.getElementById('live-time-clock');
            if (el) el.innerText = `${now.toLocaleTimeString('es-CL')} CLT`;
        }
        setInterval(updateClock, 1000);

        const canvas = document.getElementById('stars-canvas');
        const ctx = canvas.getContext('2d');
        let stars = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            stars = [];
            for (let i = 0; i < 70; i++) {
                stars.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    radius: Math.random() * 1.5 + 0.5,
                    alpha: Math.random(),
                    speed: Math.random() * 0.02 + 0.005
                });
            }
        }

        function animateStars() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            stars.forEach(s => {
                s.alpha += s.speed;
                if (s.alpha > 1 || s.alpha < 0) s.speed = -s.speed;
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(255, 255, 255, ${Math.abs(s.alpha)})`;
                ctx.fill();
            });
            requestAnimationFrame(animateStars);
        }

        window.addEventListener('resize', resizeCanvas);

        window.onload = function() {
            resizeCanvas();
            animateStars();
            renderScheduleCards();
            renderRoutesGrid();
            calculateTolls();
            updateClock();
        };
    </script>
</body>
</html>