                            <div class="relative bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 rounded-2xl p-5 border-2 border-sky-400/50 shadow-2xl space-y-4">
                                
                                <div class="bg-black text-amber-400 font-mono text-center text-xs font-black py-1.5 px-3 rounded border border-amber-500/50 tracking-widest uppercase flex justify-between items-center">
                                    <span>[08:15]</span>
                                    <span class="text-amber-300 font-extrabold">SANTIAGO ➔ CHILLÁN</span>
                                    <span>🇨🇱</span>
                                </div>

                                <div class="relative rounded-xl overflow-hidden border border-slate-700 bg-gradient-to-b from-slate-800 via-blue-950 to-slate-900 p-4 flex flex-col justify-between min-h-[150px]">
                                    
                                    <div class="h-16 bg-slate-950/90 rounded-lg border border-slate-700 p-2 flex justify-between items-start">
                                        <div class="text-[10px] text-slate-300 font-mono"><i class="fa-solid fa-couch text-amber-400"></i> Salón Cama 180°</div>
                                        <div class="text-[10px] text-emerald-400 font-mono font-bold">EME BUS RP</div>
                                    </div>

                                    <div class="pt-3 flex items-center justify-between">
                                        <div class="w-8 h-4 bg-sky-300 rounded border border-sky-100 shadow-[0_0_12px_rgba(56,189,248,0.9)]"></div>

                                        <div class="w-14 h-9 border border-slate-600 rounded shadow overflow-hidden flex flex-col">
                                            <div class="h-1/2 bg-white flex">
                                                <div class="w-1/2 bg-chile-blue flex items-center justify-center">
                                                    <i class="fa-solid fa-star text-[7px] text-white"></i>
                                                </div>
                                                <div class="w-1/2 bg-white"></div>
                                            </div>
                                            <div class="h-1/2 bg-chile-red"></div>
                                        </div>

                                        <div class="bg-white text-slate-900 font-mono font-bold text-[9px] px-2 py-0.5 rounded border border-slate-400">
                                            BUS-2026
                                        </div>

                                        <div class="w-8 h-4 bg-sky-300 rounded border border-sky-100 shadow-[0_0_12px_rgba(56,189,248,0.9)]"></div>
                                    </div>
                                </div>

